# Data (large files, not versioned). The data/ directory is kept in the
# repo but all of its contents are ignored — see data/.gitignore.

# checkpoints/, results/ and logs/ keep their directory in the repo and
# ignore their contents via their own .gitignore — the same pattern as
# data/.  They must exist on the host before `docker compose up`, or the
# daemon creates the bind-mount target as root and the container (which
# now runs as the host user) cannot write into it.

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets
.env

# Misc
*.tmp

# Model weight cache (torch hub / HuggingFace), populated on first extract.
.cache/
